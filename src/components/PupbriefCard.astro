---
import type { PupbriefLine } from "../data/profiles";
import type { Locale } from "../i18n/ui";

interface Props {
  line: PupbriefLine;
  locale: Locale;
}

const { line, locale } = Astro.props;
const openLabel = locale === "zh" ? "打开今日简报" : "Open today's brief";
---

<article
  class="card"
  data-embed-url="https://pupbrief.com/api/embed"
  data-locale={locale}
>
  <span class="slot" aria-hidden="true"></span>
  <span class="kicker">
    <span>Pupbrief</span>
    <span>CTRL97</span>
  </span>
  <div class="fallback">
    <p class="name">{line.name}</p>
    <p class="bio">{line.after.trim()}</p>
  </div>
  <div class="edition" hidden></div>
  <a class="more" href={line.href} rel="noopener noreferrer">{openLabel}</a>
</article>

<script>
  const cards = document.querySelectorAll<HTMLElement>("[data-embed-url]");

  for (const card of cards) {
    const url = card.dataset.embedUrl;
    if (!url) continue;
    void loadEdition(card, url);
  }

  async function loadEdition(card: HTMLElement, url: string) {
    try {
      const response = await fetch(url);
      if (!response.ok) return;
      const payload: unknown = await response.json();
      renderEdition(card, payload);
    } catch {
      // 接口不可用时留下原来那句介绍。
    }
  }

  function renderEdition(card: HTMLElement, payload: unknown) {
    if (!payload || typeof payload !== "object") return;
    const record = payload as { date?: unknown; items?: unknown };
    if (!Array.isArray(record.items)) return;

    const items = record.items
      .slice(0, 5)
      .map(readItem)
      .filter((item): item is EditionItem => item !== null);
    if (items.length === 0) return;

    const edition = card.querySelector<HTMLElement>(".edition");
    const fallback = card.querySelector<HTMLElement>(".fallback");
    if (!edition || !fallback) return;

    edition.replaceChildren();
    const dateLabel = formatDate(
      typeof record.date === "string" ? record.date : "",
      card.dataset.locale === "en" ? "en" : "zh",
    );
    if (dateLabel) {
      const date = document.createElement("p");
      date.className = "date";
      date.textContent = dateLabel;
      edition.append(date);
    }

    const list = document.createElement("ol");
    list.className = "items";
    items.forEach((item, index) => {
      const row = document.createElement("li");
      const link = document.createElement("a");
      link.href = item.href;
      link.rel = "noopener noreferrer";

      const title = document.createElement("span");
      title.className = "title";
      title.textContent = item.title;
      link.append(title);

      if (index === 0 && item.note) {
        const note = document.createElement("span");
        note.className = "note";
        note.textContent = item.note;
        link.append(note);
      }

      const meta = document.createElement("span");
      meta.className = "meta";
      meta.textContent = item.source ? `${item.topic} · ${item.source}` : item.topic;
      link.append(meta);

      row.append(link);
      list.append(row);
    });
    edition.append(list);
    edition.hidden = false;
    fallback.hidden = true;
  }

  type EditionItem = {
    href: string;
    topic: string;
    title: string;
    source: string;
    note: string | null;
  };

  function readItem(value: unknown): EditionItem | null {
    if (!value || typeof value !== "object") return null;
    const item = value as {
      href?: unknown;
      topic?: unknown;
      title?: unknown;
      source?: unknown;
      note?: unknown;
    };
    const href = safeHref(item.href);
    const title = typeof item.title === "string" ? item.title.trim() : "";
    const topic = typeof item.topic === "string" ? item.topic.trim() : "";
    if (!href || !title || !topic) return null;
    const source = typeof item.source === "string" ? item.source.trim() : "";
    const note = typeof item.note === "string" ? item.note.trim() : "";
    return { href, topic, title, source, note: note || null };
  }

  function safeHref(value: unknown): string | null {
    if (typeof value !== "string") return null;
    try {
      const url = new URL(value);
      if (url.protocol !== "https:" || url.hostname !== "pupbrief.com") return null;
      return url.toString();
    } catch {
      return null;
    }
  }

  function formatDate(value: string, locale: "zh" | "en"): string {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return "";
    if (locale === "zh") {
      const [year, month, day] = value.split("-");
      return `${year}年${Number(month)}月${Number(day)}日`;
    }
    const date = new Date(`${value}T12:00:00+08:00`);
    if (!Number.isFinite(date.getTime())) return "";
    return new Intl.DateTimeFormat("en", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "Asia/Shanghai",
    }).format(date);
  }
</script>

<style>
  .card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-self: start;
    padding: 16px 20px 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
  }

  .slot {
    display: block;
    width: 58px;
    height: 10px;
    margin: 2px auto 14px;
    border-radius: 999px;
    background: var(--background);
    box-shadow: inset 0 0 0 2px var(--border);
  }

  .kicker {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    line-height: 16px;
    text-transform: uppercase;
  }

  .name {
    margin: 12px 0 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .bio {
    margin: 12px 0 0;
    color: var(--text);
    font-size: 14px;
    line-height: 1.7;
  }

  .fallback[hidden],
  .edition[hidden] {
    display: none;
  }

  .edition :global(.date) {
    margin: 12px 0 0;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  .edition :global(.items) {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .edition :global(li + li) {
    border-top: 1px solid var(--border);
  }

  .edition :global(a) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 0;
    color: inherit;
    text-decoration: none;
  }

  .edition :global(a:hover .title) {
    color: var(--accent-text);
  }

  .edition :global(.title) {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .edition :global(.note) {
    color: var(--text);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.6;
  }

  .edition :global(.meta) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 16px;
  }

  .more {
    margin-top: 12px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 16px;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
