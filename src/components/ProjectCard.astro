---
import type { WorkStatus } from "../lib/taxonomy";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  title: string;
  summary: string;
  status: WorkStatus;
  statusLabel: string;
  date: Date;
  dateLabel: string;
  href?: string;
}

const { title, summary, status, statusLabel, date, dateLabel, href } =
  Astro.props;
const tone =
  status === "paused" || status === "archived" ? "neutral" : "accent";
const iso = date.toISOString().slice(0, 10);
---

<article class="card">
  <div class="meta">
    <StatusBadge tone={tone}>{statusLabel}</StatusBadge>
    <time datetime={iso}>{dateLabel}</time>
  </div>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p>{summary}</p>
</article>

<style>
  .card {
    min-width: 0;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  time {
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  h3 {
    margin: 12px 0 0;
    overflow-wrap: anywhere;
    font-size: 20px;
    font-weight: 500;
    line-height: 28px;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }

  p {
    margin: 8px 0 0;
    color: var(--muted-strong);
  }
</style>
