---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="heading">
  <h2 id={id}>{title}</h2>
</div>

<style>
  .heading {
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 36px;
  }
</style>
