---
interface Props {
  title: string;
  href: string;
  publishedAt: string;
  dateLabel: string;
  kicker?: string;
}

const { title, href, publishedAt, dateLabel, kicker } = Astro.props;
---

<article class="note">
  {kicker && <p class="kicker">{kicker}</p>}
  <time datetime={publishedAt}>{dateLabel}</time>
  <h3>
    <a href={href}>{title}</a>
  </h3>
</article>

<style>
  .note {
    min-width: 0;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .kicker,
  time {
    display: block;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  h3 {
    margin: 4px 0 0;
    overflow-wrap: anywhere;
    font-size: 20px;
    font-weight: 500;
    line-height: 28px;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
