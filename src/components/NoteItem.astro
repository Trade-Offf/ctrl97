---
import type { Locale } from "../i18n/ui";

interface Props {
  title: string;
  href: string;
  publishedAt: string;
  locale: Locale;
}

const { title, href, publishedAt, locale } = Astro.props;
const date = new Date(publishedAt);
const formatted = Number.isNaN(date.getTime())
  ? publishedAt
  : new Intl.DateTimeFormat(locale === "zh" ? "zh-Hans" : "en", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(date);
---

<article class="note">
  <time datetime={publishedAt}>{formatted}</time>
  <h3>
    <a href={href}>{title}</a>
  </h3>
</article>

<style>
  .note {
    min-width: 0;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  time {
    display: block;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  h3 {
    margin: 4px 0 0;
    font-size: 20px;
    font-weight: 500;
    line-height: 28px;
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
