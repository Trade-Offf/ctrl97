---
import { getRelativeLocaleUrl } from "astro:i18n";
import { repositories } from "../data/repositories";
import { useTranslations, type Locale } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "./RepoCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={`${t.works} — Ctrl97`}
  description={t.worksLead}
  alternates={{
    zh: getRelativeLocaleUrl("zh", "/works"),
    en: getRelativeLocaleUrl("en", "/works"),
  }}
>
  <div class="page">
    <h1>{t.works}</h1>
    <p class="lead">{t.worksLead}</p>
    <ul class="cards">
      {repositories.map((repo) => (
        <li>
          <RepoCard repo={repo} starsLabel={t.starsLabel} />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .cards {
    display: grid;
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
