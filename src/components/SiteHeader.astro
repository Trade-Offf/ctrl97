---
import { getRelativeLocaleUrl } from "astro:i18n";
import { otherLocale, useTranslations, type Locale } from "../i18n/ui";
import { buildCommands, serializeCommands } from "../lib/commands";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  languageHref?: string;
}

const { locale, languageHref } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, "/");
const switchHref =
  languageHref ?? getRelativeLocaleUrl(otherLocale(locale), "/");
const items = [
  { href: getRelativeLocaleUrl(locale, "/works"), label: t.works },
  { href: getRelativeLocaleUrl(locale, "/notes"), label: t.notes },
  { href: getRelativeLocaleUrl(locale, "/now"), label: t.now },
  { href: getRelativeLocaleUrl(locale, "/about"), label: t.about },
];
const commands = serializeCommands(await buildCommands(locale));
---

<header class="site-header">
  <div class="shell bar">
    <a class="wordmark" href={home} aria-label="Ctrl97">
      CTRL97
    </a>
    <input class="nav-toggle" id="nav-toggle" type="checkbox" />
    <div class="tools">
      <button
        class="tool"
        id="theme-toggle"
        type="button"
        aria-label={t.themeSystem}
        data-label-system={t.themeSystem}
        data-label-light={t.themeLight}
        data-label-dark={t.themeDark}
      >
        <Icon name="sun" />
      </button>
      <button
        class="tool command"
        id="command-toggle"
        type="button"
        aria-label={t.commandLabel}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="command-dialog"
      >
        <Icon name="command" />
        <kbd>Ctrl K</kbd>
      </button>
    </div>
    <label class="tool menu" for="nav-toggle">
      <span class="sr-only">{t.menu}</span>
      <Icon name="menu" />
    </label>
    <nav class="nav" aria-label={t.navLabel}>
      {items.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a class="language" href={switchHref}>
        {t.switchTo}
      </a>
    </nav>
  </div>
</header>

<div
  class="palette"
  id="command-dialog"
  role="dialog"
  aria-modal="true"
  aria-labelledby="command-title"
  hidden
>
  <div class="panel">
    <p id="command-title" class="sr-only">
      {t.commandLabel}
    </p>
    <label class="sr-only" for="command-search">
      {t.commandPlaceholder}
    </label>
    <input
      id="command-search"
      type="search"
      role="combobox"
      placeholder={t.commandPlaceholder}
      aria-controls="command-list"
      aria-autocomplete="list"
      aria-expanded="true"
      autocomplete="off"
      spellcheck="false"
    />
    <div
      id="command-list"
      role="listbox"
      tabindex="0"
      aria-label={t.commandLabel}
      data-group-go={t.groupGo}
      data-group-work={t.works}
      data-group-note={t.notes}
      data-group-action={t.groupAction}
      data-empty={t.commandEmpty}
      data-copied={t.copied}
      data-copy-failed={t.copyFailed}
    ></div>
    <p id="command-live" class="sr-only" aria-live="polite"></p>
  </div>
</div>
<script type="application/json" id="command-index" set:html={commands}></script>
<script>
  import { startPalette } from "../scripts/palette";

  startPalette();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 64px;
  }

  .wordmark {
    margin-right: auto;
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-decoration: none;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 40px;
    min-height: 40px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition:
      background-color 180ms cubic-bezier(0.2, 0, 0, 1),
      border-color 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .tool:hover {
    border-color: var(--accent-text);
  }

  .menu {
    cursor: pointer;
  }

  .nav-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    border: 0;
  }

  .nav-toggle:focus-visible ~ .menu {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  .nav {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    flex-direction: column;
    gap: 4px;
    padding: 8px 20px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .nav-toggle:checked ~ .nav {
    display: flex;
  }

  .nav a {
    display: flex;
    align-items: center;
    min-height: 40px;
    color: var(--text);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .nav a.language {
    color: var(--accent-text);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 48rem) {
    .bar {
      gap: 16px;
    }

    .wordmark {
      order: 1;
      margin-right: 0;
    }

    .nav {
      display: flex;
      position: static;
      order: 2;
      flex-direction: row;
      align-items: center;
      gap: 4px;
      width: max-content;
      margin-left: auto;
      padding: 0;
      border: 0;
      background: transparent;
    }

    .tools {
      order: 3;
    }

    .menu,
    .nav-toggle {
      display: none;
    }

    .nav a {
      padding: 0 8px;
    }

    .nav a.language {
      margin-left: 8px;
    }
  }

  @media (min-width: 64rem) {
    kbd {
      display: inline;
    }
  }

  .palette {
    position: fixed;
    z-index: 40;
    inset: 0;
    display: grid;
    align-items: start;
    justify-content: center;
    padding: 16px;
    padding-top: max(16px, 10vh);
    background: color-mix(in srgb, var(--background) 72%, transparent);
    opacity: 1;
    transition: opacity 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  .palette[hidden] {
    display: none;
  }

  .panel {
    display: flex;
    width: min(560px, 100%);
    max-height: min(70dvh, 640px);
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  #command-search {
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    padding: 16px;
    font: inherit;
    font-size: 16px;
    line-height: 26px;
  }

  #command-list {
    overflow: auto;
    padding: 8px;
  }
</style>

<style is:global>
  #command-list .group-label {
    margin: 8px 12px 4px;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  #command-list .option {
    display: flex;
    min-height: 40px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 180ms cubic-bezier(0.2, 0, 0, 1);
  }

  #command-list .option-label {
    overflow-wrap: anywhere;
  }

  #command-list .hint,
  #command-list .empty {
    color: var(--muted-strong);
    font-size: 14px;
    line-height: 20px;
  }

  #command-list .option[aria-selected="true"] {
    background: var(--background);
  }

  #command-list .empty {
    margin: 8px 12px 16px;
  }
</style>
