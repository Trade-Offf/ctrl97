---
import type { RepositoryCard } from "../data/repositories";

interface Props {
  repo: RepositoryCard;
  starsLabel: string;
}

const { repo, starsLabel } = Astro.props;
const facts = [repo.language, repo.year, `${repo.stars} ${starsLabel}`]
  .filter(Boolean)
  .join(" · ");
---

<a class="card" href={repo.href} rel="noopener noreferrer">
  {
    repo.cover && (
      <img class="figure" src={repo.cover} alt={repo.coverAlt ?? repo.name} />
    )
  }
  <div class="body">
    <p class="name">{repo.name}</p>
    {repo.description && <p class="summary">{repo.description}</p>}
    <p class="meta">{facts}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--accent-text);
    text-decoration: none;
  }

  .figure {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 16px;
  }

  .name {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 20px;
    font-weight: 500;
    line-height: 28px;
  }

  .summary {
    display: -webkit-box;
    margin: 8px 0 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--muted-strong);
    font-size: 14px;
    line-height: 22px;
  }

  .meta {
    margin: 12px 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }
</style>
