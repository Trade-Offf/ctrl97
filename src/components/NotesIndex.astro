---
import { getRelativeLocaleUrl } from "astro:i18n";
import { formatDate, useTranslations, type Locale } from "../i18n/ui";
import { entrySlug, getNotes } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "./EmptyState.astro";
import NoteItem from "./NoteItem.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = await getNotes(locale);
---

<BaseLayout
  locale={locale}
  title={`${t.notes} — Ctrl97`}
  description={t.notesLead}
  alternates={{
    zh: getRelativeLocaleUrl("zh", "/notes"),
    en: getRelativeLocaleUrl("en", "/notes"),
  }}
>
  <div class="page">
    <h1>{t.notes}</h1>
    <p class="lead">{t.notesLead}</p>
    {notes.length === 0 ? (
      <div class="empty-wrap">
        <EmptyState message={t.emptyNotes} />
      </div>
    ) : (
      <div class="list">
        {notes.map((note) => (
          <NoteItem
            title={note.data.title}
            href={getRelativeLocaleUrl(locale, `/notes/${entrySlug(note.id)}`)}
            publishedAt={note.data.publishedAt.toISOString()}
            dateLabel={formatDate(locale, note.data.publishedAt)}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .list {
    margin-top: 32px;
  }

  .empty-wrap {
    margin-top: 32px;
  }
</style>
