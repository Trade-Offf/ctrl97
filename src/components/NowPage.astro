---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getNowLanes,
  nowUpdated,
  nowUpdatedDate,
  type NowLaneId,
} from "../data/now";
import { formatDate, useTranslations, type Locale } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const lanes = getNowLanes(locale);
const updated = nowUpdatedDate();
const toneForLane: Record<NowLaneId, "accent" | "neutral"> = {
  building: "accent",
  shipping: "accent",
  writing: "neutral",
  learning: "neutral",
};
---

<BaseLayout
  locale={locale}
  title={`${t.now} — Ctrl97`}
  description={t.nowLead}
  alternates={{
    zh: getRelativeLocaleUrl("zh", "/now"),
    en: getRelativeLocaleUrl("en", "/now"),
  }}
>
  <div class="page">
    <h1>{t.now}</h1>
    <p class="lead">{t.nowLead}</p>
    <p class="meta-row">
      <span>
        {t.updated}
        <time datetime={nowUpdated}>{formatDate(locale, updated)}</time>
      </span>
    </p>
    <ul class="lanes">
      {lanes.map((lane) => (
        <li>
          <h2>
            <StatusBadge tone={toneForLane[lane.id]}>{lane.label}</StatusBadge>
          </h2>
          <p>{lane.text}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .lanes {
    max-width: 40rem;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .lanes li {
    display: grid;
    grid-template-columns: minmax(7.5rem, max-content) minmax(0, 1fr);
    gap: 12px 16px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
  }

  .lanes p {
    margin: 0;
    color: var(--muted-strong);
  }
</style>
