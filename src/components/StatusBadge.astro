---
interface Props {
  tone?: "neutral" | "accent" | "experimental";
}

const { tone = "neutral" } = Astro.props;
---

<span class:list={["badge", tone]}>
  <span class="dot" aria-hidden="true"></span>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 24px;
    width: fit-content;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--muted-strong);
  }

  .accent .dot {
    background: var(--accent);
  }

  .experimental .dot {
    background: var(--experimental);
  }
</style>
