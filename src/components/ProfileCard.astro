---
import type { ProfileCard as Profile } from "../data/profiles";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<a class="card" href={profile.href} rel="noopener noreferrer">
  <span class="slot" aria-hidden="true"></span>
  <span class="kicker">
    <span class="platform">{profile.platform}</span>
    <span>CTRL97</span>
  </span>
  <p class="name">{profile.name}</p>
  {profile.role && <p class="role">{profile.role}</p>}
  <p class="bio">{profile.bio}</p>
  {profile.fact && <p class="fact">{profile.fact}</p>}
  {
    profile.honors && profile.honors.length > 0 && (
      <ul class="honors">
        {profile.honors.map((honor) => (
          <li>{honor}</li>
        ))}
      </ul>
    )
  }
  {
    profile.stats && profile.stats.length > 0 && (
      <dl class="stats">
        {profile.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  {profile.asOf && <p class="as-of">{profile.asOf}</p>}
  {
    profile.cover && (
      <img class="figure" src={profile.cover} alt={profile.coverAlt ?? ""} />
    )
  }
</a>

<style>
  .card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 16px 20px 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--accent-text);
    text-decoration: none;
  }

  .slot {
    display: block;
    width: 58px;
    height: 10px;
    margin: 2px auto 14px;
    border-radius: 999px;
    background: var(--background);
    box-shadow: inset 0 0 0 2px var(--border);
  }

  .kicker {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    line-height: 16px;
    text-transform: uppercase;
  }

  .name {
    margin: 12px 0 0;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .role,
  .fact,
  .as-of {
    margin: 0;
    color: var(--muted-strong);
    font-size: 13px;
    line-height: 20px;
  }

  .role,
  .bio,
  .fact {
    margin-top: 8px;
  }

  .bio {
    margin-bottom: 0;
    color: var(--text);
    font-size: 14px;
    line-height: 1.7;
  }

  .honors {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .honors li {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 8px;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    line-height: 16px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 16px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .stats div {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
  }

  dt {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.4;
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .as-of {
    margin-top: 10px;
    color: var(--muted);
    font-size: 11px;
  }

  .figure {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 14px;
    border-radius: 8px;
  }
</style>
