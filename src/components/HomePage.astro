---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getNotes, entrySlug } from "../lib/content";
import { getProfiles, getPupbrief } from "../data/profiles";
import { presence } from "../data/site";
import { formatDate, useTranslations, type Locale } from "../i18n/ui";
import Button from "./Button.astro";
import ProfileCard from "./ProfileCard.astro";
import PupbriefCard from "./PupbriefCard.astro";
import EmptyState from "./EmptyState.astro";
import NoteItem from "./NoteItem.astro";
import SectionHeader from "./SectionHeader.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const profiles = getProfiles(locale);
const pupbrief = getPupbrief(locale);
const latestNotes = (await getNotes(locale)).slice(0, 6);
---

<div class="home">
  <section class="intro">
    <div class="hero">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="lede">{t.description}</p>
      <p class="motto">{t.motto}</p>
      <StatusBadge tone="accent">{presence}</StatusBadge>
      <div class="actions">
        <Button href={getRelativeLocaleUrl(locale, "/works")}>
          {t.viewWorks}
        </Button>
        <Button href={getRelativeLocaleUrl(locale, "/notes")} variant="quiet">
          {t.readNotes}
        </Button>
      </div>
    </div>
    <PupbriefCard line={pupbrief} locale={locale} />
  </section>

  <section class="block" aria-labelledby="profiles-heading">
    <SectionHeader id="profiles-heading" title={t.profilesTitle} />
    <div class="profiles">
      {profiles.map((profile) => (
        <ProfileCard profile={profile} />
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="notes-heading">
    <SectionHeader id="notes-heading" title={t.notesTitle} />
    {latestNotes.length > 0 ? (
      <div class="notes">
        {latestNotes.map((note) => (
          <NoteItem
            title={note.data.title}
            href={getRelativeLocaleUrl(locale, `/notes/${entrySlug(note.id)}`)}
            publishedAt={note.data.publishedAt.toISOString()}
            dateLabel={formatDate(locale, note.data.publishedAt)}
            kicker={t.categoryLabel[note.data.category]}
          />
        ))}
      </div>
    ) : (
      <EmptyState message={t.emptyNotesHome} />
    )}
  </section>
</div>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 0 48px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .eyebrow {
    margin: 0;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  h1 {
    margin: 0;
    font-size: 40px;
    font-weight: 500;
    line-height: 48px;
  }

  .lede,
  .motto {
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .profiles {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes {
    display: grid;
    gap: 0 24px;
  }

  @media (min-width: 48rem) {
    .intro {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
      align-items: start;
    }

    .profiles,
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
