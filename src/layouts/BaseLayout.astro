---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/source-serif-4/latin-400.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import { otherLocale, useTranslations, type Locale } from "../i18n/ui";
import { themeStorageKey } from "../data/site";
import {
  blogPostingJsonLd,
  personJsonLd,
  serializeJsonLd,
  websiteJsonLd,
} from "../lib/seo";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  languageHref?: string;
  alternates?: { zh: string; en: string };
  includePerson?: boolean;
  noindex?: boolean;
  article?: {
    headline: string;
    publishedAt: Date;
    updatedAt?: Date;
  };
}

const {
  locale,
  title,
  description,
  languageHref,
  alternates,
  includePerson = false,
  noindex = false,
  article,
} = Astro.props;
const t = useTranslations(locale);
const htmlLang = locale === "zh" ? "zh-Hans" : "en";
const canonical = new URL(Astro.url.pathname, Astro.site);
const barePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const switchHref =
  languageHref ?? getRelativeLocaleUrl(otherLocale(locale), barePath);
const homeAlternates =
  barePath === "/"
    ? {
        zh: new URL(getRelativeLocaleUrl("zh", "/"), Astro.site).href,
        en: new URL(getRelativeLocaleUrl("en", "/"), Astro.site).href,
      }
    : undefined;
const alternateLinks = alternates
  ? {
      zh: new URL(alternates.zh, Astro.site).href,
      en: new URL(alternates.en, Astro.site).href,
    }
  : homeAlternates;
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
const alternateOgLocale = locale === "zh" ? "en_US" : "zh_CN";
const rssPath = locale === "en" ? "/en/rss.xml" : "/rss.xml";
const rssUrl = new URL(rssPath, Astro.site);
const authorUrl = new URL(
  locale === "en" ? "/en/about/" : "/about/",
  Astro.site,
);
const jsonLd = serializeJsonLd([
  websiteJsonLd(),
  ...(includePerson ? [personJsonLd()] : []),
  ...(article
    ? [
        blogPostingJsonLd({
          locale,
          headline: article.headline,
          description,
          url: canonical.href,
          publishedAt: article.publishedAt,
          updatedAt: article.updatedAt,
        }),
      ]
    : []),
]);
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        var storedTheme = localStorage.getItem(themeStorageKey);
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        }
      } catch (error) {
        /* private mode can block storage */
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ctrl97"
      href={rssUrl.href}
    />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="Ctrl97" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:locale" content={ogLocale} />
    {alternateLinks && (
      <meta property="og:locale:alternate" content={alternateOgLocale} />
    )}
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.publishedAt.toISOString()}
        />
        {article.updatedAt && (
          <meta
            property="article:modified_time"
            content={article.updatedAt.toISOString()}
          />
        )}
        <meta property="article:author" content={authorUrl.href} />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {alternateLinks && (
      <>
        <link rel="alternate" hreflang="zh-Hans" href={alternateLinks.zh} />
        <link rel="alternate" hreflang="en" href={alternateLinks.en} />
        <link rel="alternate" hreflang="x-default" href={alternateLinks.zh} />
      </>
    )}
    <meta
      name="theme-color"
      content="#F7F7F5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111110"
      media="(prefers-color-scheme: dark)"
    />
    <script type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t.skip}
    </a>
    <SiteHeader locale={locale} languageHref={switchHref} />
    <main id="content" class="shell">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
