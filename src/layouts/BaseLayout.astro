---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/source-serif-4/latin-400.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import { otherLocale, useTranslations, type Locale } from "../i18n/ui";
import { themeStorageKey } from "../data/site";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  languageHref?: string;
  alternates?: { zh: string; en: string };
}

const { locale, title, description, languageHref, alternates } = Astro.props;
const t = useTranslations(locale);
const htmlLang = locale === "zh" ? "zh-Hans" : "en";
const canonical = new URL(Astro.url.pathname, Astro.site);
const barePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
const switchHref =
  languageHref ?? getRelativeLocaleUrl(otherLocale(locale), barePath);
const homeAlternates =
  barePath === "/"
    ? {
        zh: new URL(getRelativeLocaleUrl("zh", "/"), Astro.site).href,
        en: new URL(getRelativeLocaleUrl("en", "/"), Astro.site).href,
      }
    : undefined;
const alternateLinks = alternates
  ? {
      zh: new URL(alternates.zh, Astro.site).href,
      en: new URL(alternates.en, Astro.site).href,
    }
  : homeAlternates;
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        var storedTheme = localStorage.getItem(themeStorageKey);
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        }
      } catch (error) {
        /* private mode can block storage */
      }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {alternateLinks && (
      <>
        <link rel="alternate" hreflang="zh-Hans" href={alternateLinks.zh} />
        <link rel="alternate" hreflang="en" href={alternateLinks.en} />
        <link rel="alternate" hreflang="x-default" href={alternateLinks.zh} />
      </>
    )}
    <meta
      name="theme-color"
      content="#F7F7F5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111110"
      media="(prefers-color-scheme: dark)"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t.skip}
    </a>
    <SiteHeader locale={locale} languageHref={switchHref} />
    <main id="content" class="shell">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
