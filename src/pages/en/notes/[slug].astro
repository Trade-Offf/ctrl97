---
import NoteDetail from "../../../components/NoteDetail.astro";
import { notePaths } from "../../../lib/content";

export async function getStaticPaths() {
  return notePaths("en");
}

const slug = Astro.params.slug;

if (!slug) {
  throw new Error("Missing note slug");
}
---

<NoteDetail locale="en" slug={slug} />
